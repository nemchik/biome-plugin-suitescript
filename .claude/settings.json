{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/flow-reminders.ts\"",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run verify:doctor)",
      "Bash(npm run verify:run -- *)",
      "Bash(npm run verify:deploy)"
    ],
    "deny": [
      "Bash(npm run verify:deploy *--approved*)",
      "Bash(npm run verify:cleanup *--approved*)"
    ]
  }
}
