<restlet scriptid="customscript_biome_verification_runner">
  <description>Runs one version-controlled probe by name in a sandbox. Source: the biome-plugin-suitescript repository, verification/.</description>
  <isinactive>F</isinactive>
  <name>Biome plugin verification runner</name>
  <notifyowner>F</notifyowner>
  <scriptfile>[/SuiteScripts/biome-plugin-suitescript-verification/runner.js]</scriptfile>
  <scriptdeployments>
    <scriptdeployment scriptid="customdeploy_biome_verification_runner">
      <allroles>F</allroles>
      <audslctrole>[customrole_biome_verification]</audslctrole>
      <isdeployed>T</isdeployed>
      <loglevel>DEBUG</loglevel>
      <status>RELEASED</status>
      <title>Biome plugin verification runner</title>
    </scriptdeployment>
  </scriptdeployments>
</restlet>
