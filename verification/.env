# Layout only: this file is committed. Credentials go in .env.local, which is gitignored.
SUITESCRIPT_VERIFY_PROBES_DIR=verification/probes
SUITESCRIPT_VERIFY_RESULTS_DIR=docs/verification/results
SUITESCRIPT_VERIFY_SDF_DIR=verification/sdf
# This repository's own probe tags (the package validates that a tag is known).
SUITESCRIPT_VERIFY_EXTRA_TAGS=contradiction,rule,tooling
# The role the runner is limited to (the package default is customrole_suitescript_verify).
SUITESCRIPT_VERIFY_ROLE_ID=customrole_biome_verification
