{
  "name": "biome-plugin-suitescript",
  "version": "0.6.0",
  "description": "Biome lint plugins and a tag checker for NetSuite SuiteScript 2.1, ported from eslint-plugin-suitescript.",
  "keywords": [
    "biome-plugin",
    "biome",
    "suitescript",
    "netsuite",
    "lint"
  ],
  "homepage": "https://github.com/nemchik/biome-plugin-suitescript#readme",
  "bugs": "https://github.com/nemchik/biome-plugin-suitescript/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nemchik/biome-plugin-suitescript.git"
  },
  "license": "MIT",
  "author": "Eric Nemchik",
  "type": "module",
  "exports": {
    "./schema.json": "./schema.json",
    "biome": "./biome-manifest.json"
  },
  "bin": {
    "biome-plugin-suitescript": "./dist/bin/biome-plugin-suitescript.js"
  },
  "files": [
    "biome-manifest.json",
    "configs",
    "dist",
    "schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require(\\\"node:fs\\\").rmSync(\\\"dist\\\",{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json && node scripts/build-manifest.ts",
    "check": "biome check",
    "docs": "node scripts/rule-docs.ts && node scripts/migration-table.ts",
    "preformat": "npm run typecheck",
    "format": "biome check --write",
    "lint": "biome lint",
    "new-rule": "node scripts/new-rule.ts",
    "prepack": "npm run build",
    "readme": "node scripts/rules-table.ts",
    "skills": "skills",
    "skills:add": "skills add --skill \"*\" --agent universal --agent claude-code --yes",
    "skills:check": "skills check",
    "skills:install": "skills experimental_install && node scripts/link-claude-skills.ts",
    "skills:list": "skills list",
    "skills:update": "skills update --project --yes && node scripts/link-claude-skills.ts",
    "sync-modules": "node scripts/sync-modules.ts",
    "sync-typings": "node scripts/sync-typings.ts",
    "pretest": "npm run build",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc",
    "verify:certificate": "node scripts/verify.ts certificate",
    "verify:cleanup": "node scripts/verify.ts cleanup",
    "verify:deploy": "node scripts/verify.ts deploy",
    "verify:doctor": "node scripts/verify.ts doctor",
    "verify:env": "node scripts/verify.ts env",
    "verify:passkey": "node scripts/verify.ts passkey",
    "verify:run": "node scripts/verify.ts run",
    "verify:setup-ci": "node scripts/verify.ts setup-ci"
  },
  "dependencies": {
    "oxc-parser": "^0.157.0",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@biomejs/runtime": "2.6.4",
    "@hitc/netsuite-types": "2026.2.5",
    "@oracle/suitecloud-cli": "4.1.1",
    "@types/node": "24.19.2",
    "git-pull-run": "2.1.0",
    "lefthook": "2.2.2",
    "skills": "1.7.6",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@biomejs/biome": "^2.6.4"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.2",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.2.1",
      "onFail": "warn"
    }
  },
  "allowScripts": {
    "lefthook": true
  }
}
