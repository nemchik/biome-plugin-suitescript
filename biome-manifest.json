{
  "$schema": "./node_modules/@biomejs/biome/manifest_schema.json",
  "configs": [
    {
      "suitescript2": "./configs/suitescript2.json"
    }
  ],
  "plugins": {
    "presets": {
      "all": [
        "noAmdName",
        "noExtraModules",
        "noInvalidModules",
        "noModuleExtensions",
        "moduleVars",
        "logRequireTitle",
        "logRequireDetails",
        "noMissingModules",
        "noGlobalShadowing",
        "noEval",
        "noDynamicSuiteQL",
        "noSuiteScript1Api",
        "noModuleScopeApiCalls",
        "noWrongScriptTypeModules",
        "noBrowserGlobals",
        "noUserEventContextSave",
        "noInsecureHttpsUrl",
        "entryPoints",
        "noRecordInLoop",
        "noNativeIterators",
        "noBeforeSubmitRecordReload",
        "noEmptyEntryPoints",
        "noMapReduceSearchResults",
        "requireCustpagePrefix",
        "noHeaderUnderscores",
        "noQueryColumnFieldAndFormula",
        "requireClientValidateReturn",
        "noClientLog"
      ],
      "minimal": ["noExtraModules", "noInvalidModules"],
      "recommended": [
        "noAmdName",
        "noExtraModules",
        "noInvalidModules",
        "noModuleExtensions",
        "moduleVars",
        "logRequireTitle",
        "logRequireDetails",
        "noMissingModules",
        "noGlobalShadowing",
        "noEval",
        "noDynamicSuiteQL",
        "noSuiteScript1Api",
        "noModuleScopeApiCalls",
        "noWrongScriptTypeModules",
        "noBrowserGlobals",
        "noUserEventContextSave",
        "noInsecureHttpsUrl"
      ]
    },
    "rules": [
      {
        "entryPoints": "./dist/rules/entryPoints.js"
      },
      {
        "logRequireDetails": "./dist/rules/logRequireDetails.js"
      },
      {
        "logRequireTitle": "./dist/rules/logRequireTitle.js"
      },
      {
        "moduleVars": "./dist/rules/moduleVars.js"
      },
      {
        "noAmdName": "./dist/rules/noAmdName.grit"
      },
      {
        "noBeforeSubmitRecordReload": "./dist/rules/noBeforeSubmitRecordReload.js"
      },
      {
        "noBrowserGlobals": "./dist/rules/noBrowserGlobals.js"
      },
      {
        "noClientLog": "./dist/rules/noClientLog.js"
      },
      {
        "noDynamicSuiteQL": "./dist/rules/noDynamicSuiteQL.js"
      },
      {
        "noEmptyEntryPoints": "./dist/rules/noEmptyEntryPoints.js"
      },
      {
        "noEval": "./dist/rules/noEval.js"
      },
      {
        "noExtraModules": "./dist/rules/noExtraModules.js"
      },
      {
        "noGlobalShadowing": "./dist/rules/noGlobalShadowing.js"
      },
      {
        "noHardcodedSecrets": "./dist/rules/noHardcodedSecrets.js"
      },
      {
        "noHeaderUnderscores": "./dist/rules/noHeaderUnderscores.js"
      },
      {
        "noInsecureHttpsUrl": "./dist/rules/noInsecureHttpsUrl.js"
      },
      {
        "noInvalidModules": "./dist/rules/noInvalidModules.js"
      },
      {
        "noLogModule": "./dist/rules/noLogModule.js"
      },
      {
        "noMapReduceSearchResults": "./dist/rules/noMapReduceSearchResults.js"
      },
      {
        "noMissingModules": "./dist/rules/noMissingModules.js"
      },
      {
        "noModuleExtensions": "./dist/rules/noModuleExtensions.grit"
      },
      {
        "noModuleScopeApiCalls": "./dist/rules/noModuleScopeApiCalls.js"
      },
      {
        "noNativeIterators": "./dist/rules/noNativeIterators.js"
      },
      {
        "noQueryColumnFieldAndFormula": "./dist/rules/noQueryColumnFieldAndFormula.js"
      },
      {
        "noRecordInLoop": "./dist/rules/noRecordInLoop.js"
      },
      {
        "noSuiteScript1Api": "./dist/rules/noSuiteScript1Api.js"
      },
      {
        "noUserEventContextSave": "./dist/rules/noUserEventContextSave.js"
      },
      {
        "noWrongScriptTypeModules": "./dist/rules/noWrongScriptTypeModules.js"
      },
      {
        "requireClientValidateReturn": "./dist/rules/requireClientValidateReturn.js"
      },
      {
        "requireCustpagePrefix": "./dist/rules/requireCustpagePrefix.js"
      }
    ]
  },
  "version": 1
}
